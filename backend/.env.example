PORT=4000
PG_PORT=55432
JWT_SECRET=replace-with-a-long-random-string
# Leave DATABASE_URL empty to use the built-in embedded PostgreSQL (local dev).
# For production, point it at a real Postgres (Neon, Supabase, RDS, local install):
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGSSL=true
